{
  "name": "mission-control",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",

  // Only web/ is uploaded - the check scripts and the notes beside it stay
  // in the repo and off the internet.
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    // Only these paths reach worker.js; everything else is a plain file.
    // /relay is not a file, so it has to be listed or it would 404.
    "run_worker_first": ["/relay"]
  }

  // Secrets, set in the dashboard and never written here:
  //   TURN_KEY_ID, TURN_KEY_API_TOKEN - the relay (see worker.js). Optional.
}
